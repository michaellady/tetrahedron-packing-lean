theorem quantization_bound (i : Fin 4) (a : Fin 4) (r : Fin 3) :
    |reference i a r - (vertices i a r : ℚ) / 1000000000| ≤ (1 : ℚ) / 1000000000 := by
  fin_cases i
  · exact rational_quantization_bound (rounded0 a r).1 (by decide) (rounded0 a r).2
  · exact rational_quantization_bound (rounded1 a r).1 (by decide) (rounded1 a r).2
  · exact rational_quantization_bound (rounded2 a r).1 (by decide) (rounded2 a r).2
  · exact rational_quantization_bound (rounded3 a r).1 (by decide) (rounded3 a r).2

theorem disjoint_within_clearance (C : (Fin 3 → ℝ) ≃ₗ[ℝ] (Fin 3 → ℝ))
    (u : Fin 4 → Fin 4 → Fin 3 → ℝ)
    (hδ : ∀ i a r, |u i a r - (vertices i a r : ℝ) / 1000000000| ≤
      (77893 : ℝ) / 1000000000)
    (i j : Fin 4) (k : Fin 3 → ℤ) (hk : i ≠ j ∨ k ≠ 0) :
    Disjoint (interior (convexHull ℝ (range (fun a => C.symm (u i a)))))
      (interior (convexHull ℝ (range (fun a => C.symm (u j a) +
        C.symm (fun r => (k r : ℝ)))))) := by
  fin_cases i
  · exact disjoint_interiors_of_checkClearancePair C vertices u 0 j
      (d := 1000000000) (ε := 77893) (by decide) (by decide) hδ
      (axes0 j) (checked0 j) k hk
  · exact disjoint_interiors_of_checkClearancePair C vertices u 1 j
      (d := 1000000000) (ε := 77893) (by decide) (by decide) hδ
      (axes1 j) (checked1 j) k hk
  · exact disjoint_interiors_of_checkClearancePair C vertices u 2 j
      (d := 1000000000) (ε := 77893) (by decide) (by decide) hδ
      (axes2 j) (checked2 j) k hk
  · exact disjoint_interiors_of_checkClearancePair C vertices u 3 j
      (d := 1000000000) (ε := 77893) (by decide) (by decide) hδ
      (axes3 j) (checked3 j) k hk

theorem disjoint_near_reference (C : (Fin 3 → ℝ) ≃ₗ[ℝ] (Fin 3 → ℝ))
    (u : Fin 4 → Fin 4 → Fin 3 → ℝ)
    (hδ : ∀ i a r, |u i a r - (reference i a r : ℝ)| ≤
      (77893 - 1 : ℝ) / 1000000000)
    (i j : Fin 4) (k : Fin 3 → ℤ) (hk : i ≠ j ∨ k ≠ 0) :
    Disjoint (interior (convexHull ℝ (range (fun a => C.symm (u i a)))))
      (interior (convexHull ℝ (range (fun a => C.symm (u j a) +
        C.symm (fun r => (k r : ℝ)))))) := by
  apply disjoint_within_clearance C u _ i j k hk
  intro p a r
  simpa using clearance_of_quantized_coordinate _ _ _ 1000000000 77893
    (quantization_bound p a r) (hδ p a r)

theorem pairwise_disjoint_near_reference (C : (Fin 3 → ℝ) ≃ₗ[ℝ] (Fin 3 → ℝ))
    (u : Fin 4 → Fin 4 → Fin 3 → ℝ)
    (hδ : ∀ i a r, |u i a r - (reference i a r : ℝ)| ≤
      (77893 - 1 : ℝ) / 1000000000) :
    let piece (p : Fin 4 × (Fin 3 → ℤ)) :=
      convexHull ℝ (range (fun a => C.symm (u p.1 a) +
        C.symm (fun r => (p.2 r : ℝ))))
    Pairwise fun p q => Disjoint (interior (piece p)) (interior (piece q)) := by
  exact pairwise_disjoint_of_relative_shift C (fun i a => C.symm (u i a))
    (disjoint_near_reference C u hδ)

#print axioms quantization_bound
#print axioms disjoint_within_clearance
#print axioms disjoint_near_reference
#print axioms pairwise_disjoint_near_reference

